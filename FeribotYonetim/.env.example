# ============================================
# FERİBOT YÖNETİM SİSTEMİ - HOSTINGER YAPILANDIRMASI
# ============================================
# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizi girin
# cp .env.example .env

# ============================================
# VERİTABANI AYARLARI (PostgreSQL)
# ============================================
# Hostinger VPS PostgreSQL veritabanı
# Format: postgresql://kullanici:sifre@host:port/veritabani_adi
DATABASE_URL=postgresql://feribotuser:GÜÇLÜ_ŞİFRENİZ@localhost:5432/feribot_db

# SSL bağlantısı (harici veritabanı için true, localhost için false)
DB_SSL=false

# ============================================
# UYGULAMA AYARLARI
# ============================================
# Uygulama portu (Hostinger VPS'de reverse proxy ile kullanılır)
PORT=3000

# Ortam (production veya development)
NODE_ENV=production

# Oturum gizli anahtarı (rastgele güçlü bir string olmalı)
# Oluşturmak için: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=BURAYA_RASTGELE_GÜÇLÜ_BİR_ANAHTAR_GİRİN

# ============================================
# DOMAIN AYARLARI
# ============================================
# Sitenizin domain adresi (https dahil)
SITE_URL=https://siteniz.com
CORS_ORIGIN=https://siteniz.com

# ============================================
# ÖDEME SİSTEMİ AYARLARI (İsteğe bağlı)
# ============================================
# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# iyzico
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com

# PayTR
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# ============================================
# E-POSTA AYARLARI (İsteğe bağlı)
# ============================================
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@siteniz.com
SENDGRID_FROM_NAME=Feribot Yönetim

# ============================================
# WHATSAPP AYARLARI (İsteğe bağlı)
# ============================================
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ============================================
# DİĞER AYARLAR
# ============================================
# Demo modu (production'da false olmalı)
DEMO_MODE=false

# OpenAI API (AI önerileri için - isteğe bağlı)
OPENAI_API_KEY=

# Google Analytics
GOOGLE_ANALYTICS_ID=
