  async updateBookingPaymentStatus(id: number, status: 'paid' | 'pending' | 'failed'): Promise<Booking | undefined> {
    const isPaid = status === 'paid';
    
    const [updated] = await db
      .update(bookings)
      .set({ 
        isPaid, 
        status: isPaid ? 'confirmed' : status === 'failed' ? 'payment_failed' : 'pending'
      })
      .where(eq(bookings.id, id))
      .returning();
    
    return updated;
  }

  async deleteBooking(id: number): Promise<boolean> {
    await db.delete(bookings).where(eq(bookings.id, id));
    return true;
  }

