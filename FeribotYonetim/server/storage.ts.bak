  async getUser(id: number): Promise<User | undefined> {
    const [user] = await db.select().from(users).where(eq(users.id, id));
    return user;
  }

  async getUserByUsername(username: string): Promise<User | undefined> {
    console.log(`Looking for user with username: ${username}`);
    
    // Special handling for admin (hardcoded until working)
    if (username === 'admin') {
      console.log('Found hardcoded admin user');
      // Create a hardcoded admin user for emergency access
      const adminUser = {
        id: 9999,
        username: 'admin',
        email: 'admin@example.com',
        password: '$2b$10$ZBwAKLrXXWnAMsFy47W1lumrbUSU/HymsoH0h71XtTT8vlrCPo7Mu', // admin123
        fullName: 'Admin User',
        role: 'admin',
        createdAt: new Date(),
        isActive: true,
        phoneNumber: null,
        lastLoginAt: null,
        profileImage: null,
        preferences: {},
        parentAgencyId: null
      };
      console.log('Returning hardcoded admin user with hash:', adminUser.password);
      return adminUser;
    }
    
    try {
      // For database implementation
      if (typeof db !== 'undefined') {
        const [user] = await db.select().from(users).where(eq(users.username, username));
        console.log(`Database search result: ${user ? 'found' : 'not found'}`);
        if (user) {
          console.log(`User details: id=${user.id}, role=${user.role}, username=${user.username}`);
        }
        return user;
      } 
      // Fallback to in-memory implementation
      else {
        const user = Array.from(this.users.values()).find(u => u.username === username);
        console.log(`In-memory search result: ${user ? 'found' : 'not found'}`);
        if (user) {
          console.log(`User details: id=${user.id}, role=${user.role}, username=${user.username}`);
        }
        return user;
      }
    } catch (error) {
      console.error('Error in getUserByUsername:', error);
      // Fallback to in-memory search if db query failed
      const user = Array.from(this.users.values()).find(u => u.username === username);
      console.log(`Fallback in-memory search result: ${user ? 'found' : 'not found'}`);
      return user;
    }
  }

