// Database implementation of IStorage
export class DatabaseStorage implements IStorage {
  sessionStore: session.Store;

  constructor() {
    this.sessionStore = new PostgresSessionStore({
      pool,
      tableName: "session",
      createTableIfMissing: true
    });
  }
  }
  
  // Bus Wagner Supplier operations
  async getBusWagnerSupplier(id: number): Promise<BusWagnerSupplier | undefined> {
    const [supplier] = await db
      .select()
      .from(busWagnerSuppliers)
      .where(eq(busWagnerSuppliers.id, id));
    
    return supplier;
  }

  async getBusWagnerSuppliers(): Promise<BusWagnerSupplier[]> {
    return await db.select().from(busWagnerSuppliers);
  }

  async createBusWagnerSupplier(supplier: InsertBusWagnerSupplier): Promise<BusWagnerSupplier> {
    const [created] = await db
      .insert(busWagnerSuppliers)
      .values({
        ...supplier,
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString()
      })
      .returning();
    
    return created;
  }

  async updateBusWagnerSupplier(id: number, data: Partial<BusWagnerSupplier>): Promise<BusWagnerSupplier | undefined> {
    // Always update the updatedAt field
    const updateData = {
      ...data,
      updatedAt: new Date().toISOString()
    };
    
    const [updated] = await db
      .update(busWagnerSuppliers)
      .set(updateData)
      .where(eq(busWagnerSuppliers.id, id))
      .returning();
    
    return updated;
  }

  async deleteBusWagnerSupplier(id: number): Promise<boolean> {
    try {
      // İlişkili rotaları sil
      const routes = await this.getBusWagnerRoutes(id);
      for (const route of routes) {
        await this.deleteBusWagnerRoute(route.id);
      }
      
      // İlişkili senkronizasyon loglarını sil
      await db.delete(busWagnerSyncLogs).where(eq(busWagnerSyncLogs.supplierId, id));
      
      // Tedarikçiyi sil
      await db.delete(busWagnerSuppliers).where(eq(busWagnerSuppliers.id, id));
      
      return true;
    } catch (error) {
      console.error("Failed to delete Bus Wagner supplier:", error);
      return false;
    }
  }
  
  // Bus Wagner Route operations
  async getBusWagnerRoute(id: number): Promise<BusWagnerRoute | undefined> {
    const [route] = await db
      .select()
      .from(busWagnerRoutes)
      .where(eq(busWagnerRoutes.id, id));
    
    return route;
  }

  async getBusWagnerRouteByExternalId(externalId: string): Promise<BusWagnerRoute | undefined> {
    const [route] = await db
      .select()
      .from(busWagnerRoutes)
      .where(eq(busWagnerRoutes.externalRouteId, externalId));
    
    return route;
  }

  async getBusWagnerRoutes(supplierId?: number): Promise<BusWagnerRoute[]> {
    if (supplierId) {
      return await db
        .select()
        .from(busWagnerRoutes)
        .where(eq(busWagnerRoutes.supplierId, supplierId));
    }
    
    return await db.select().from(busWagnerRoutes);
  }

  async createBusWagnerRoute(route: InsertBusWagnerRoute): Promise<BusWagnerRoute> {
    const [created] = await db
      .insert(busWagnerRoutes)
      .values(route)
      .returning();
    
    return created;
  }

  async updateBusWagnerRoute(id: number, data: Partial<BusWagnerRoute>): Promise<BusWagnerRoute | undefined> {
    const [updated] = await db
      .update(busWagnerRoutes)
      .set(data)
      .where(eq(busWagnerRoutes.id, id))
      .returning();
    
    return updated;
  }

  async deleteBusWagnerRoute(id: number): Promise<boolean> {
    try {
      // İlişkili seferleri sil
      const schedules = await db
        .select()
        .from(busWagnerSchedules)
        .where(eq(busWagnerSchedules.routeId, id));
      
      for (const schedule of schedules) {
        // İlişkili koltukları sil
        await db.delete(busWagnerSeats).where(eq(busWagnerSeats.scheduleId, schedule.id));
        
        // İlişkili rezervasyonları sil
        await db.delete(busWagnerBookings).where(eq(busWagnerBookings.scheduleId, schedule.id));
      }
      
      // Seferleri sil
      await db.delete(busWagnerSchedules).where(eq(busWagnerSchedules.routeId, id));
      
      // Rotayı sil
      await db.delete(busWagnerRoutes).where(eq(busWagnerRoutes.id, id));
      
      return true;
    } catch (error) {
      console.error("Failed to delete Bus Wagner route:", error);
      return false;
    }
  }
  
  // Bus Wagner Sync Log operations
  async createBusWagnerSyncLog(log: InsertBusWagnerSyncLog): Promise<number> {
    const [created] = await db
      .insert(busWagnerSyncLogs)
      .values({
        ...log,
        createdAt: new Date().toISOString()
      })
      .returning();
    
    return created.id;
  }

  async updateBusWagnerSyncLog(id: number, data: Partial<BusWagnerSyncLog>): Promise<BusWagnerSyncLog | undefined> {
    const [updated] = await db
      .update(busWagnerSyncLogs)
      .set(data)
      .where(eq(busWagnerSyncLogs.id, id))
      .returning();
    
    return updated;
  }

  async getBusWagnerSyncLogs(supplierId?: number): Promise<BusWagnerSyncLog[]> {
    if (supplierId) {
      return await db
        .select()
        .from(busWagnerSyncLogs)
        .where(eq(busWagnerSyncLogs.supplierId, supplierId))
        .orderBy(desc(busWagnerSyncLogs.createdAt));
    }
    
    return await db
      .select()
      .from(busWagnerSyncLogs)
      .orderBy(desc(busWagnerSyncLogs.createdAt));
  }

