  // Membership Tier methods
  async getAllMembershipTiers(): Promise<MembershipTier[]> {
    return [...this.membershipTiers];
  }
  
  async getMembershipTierById(id: number): Promise<MembershipTier | undefined> {
    return this.membershipTiers.find(tier => tier.id === id);
  }
  
  async getMembershipTier(id: number): Promise<MembershipTier | undefined> {
    return this.getMembershipTierById(id);
  }
  
  async getUsersByMembershipTier(tierId: number): Promise<User[]> {
    return [...this.users.values()].filter(user => user.membershipTierId === tierId);
  }
  
  async createMembershipTier(data: InsertMembershipTier): Promise<MembershipTier> {
    const id = Math.max(0, ...this.membershipTiers.map(tier => tier.id)) + 1;
    const newTier: MembershipTier = {
      id,
      ...data,
      createdAt: new Date(),
      updatedAt: new Date()
    };
    this.membershipTiers.push(newTier);
    return newTier;
  }
  
  async updateMembershipTier(id: number, data: Partial<MembershipTier>): Promise<MembershipTier | undefined> {
    const index = this.membershipTiers.findIndex(tier => tier.id === id);
    if (index === -1) return undefined;
    
    const updatedTier: MembershipTier = {
      ...this.membershipTiers[index],
      ...data,
      id, // Ensure id doesn't change
      updatedAt: new Date()
    };
    
    this.membershipTiers[index] = updatedTier;
    return updatedTier;
  }
  
  async deleteMembershipTier(id: number): Promise<boolean> {
    // Üyelik seviyesini kullanan kullanıcılar var mı kontrol et
    const usersWithTier = await this.getUsersByMembershipTier(id);
    if (usersWithTier.length > 0) {
      // Bu üyelik seviyesini kullanan kullanıcılar varsa silme işlemini gerçekleştirme
      return false;
    }
    
    const index = this.membershipTiers.findIndex(tier => tier.id === id);
    if (index === -1) return false;
    
    this.membershipTiers.splice(index, 1);
    return true;
  }
  
  // Review ve kullanıcı profili ile ilgili işlemler
  // Tüm yorumları getir
  async getAllReviews(): Promise<Review[]> {
    return this.reviews;
  }

  // ID'ye göre yorum getir
  async getReview(id: number): Promise<Review | undefined> {
    return this.reviews.find(review => review.id === id);
  }

  // Rota ID'sine göre yorumları getir
  async getReviewsByRouteId(routeId: number): Promise<Review[]> {
    return this.reviews.filter(review => review.routeId === routeId);
  }

  // Kullanıcı ID'sine göre yorumları getir
  async getReviewsByUserId(userId: number): Promise<Review[]> {
    return this.reviews.filter(review => review.userId === userId);
  }

  // Feribot şirketine göre yorumları getir
  async getReviewsByFerryCompanyId(companyId: number): Promise<Review[]> {
    return this.reviews.filter(review => review.ferryCompanyId === companyId);
  }

  // Rezervasyon ID'sine göre yorumları getir
  async getReviewsByBookingId(bookingId: number): Promise<Review[]> {
    return this.reviews.filter(review => review.bookingId === bookingId);
  }

  // Yeni yorum oluştur
  async createReview(data: InsertReview): Promise<Review> {
    const id = this.nextReviewId++;
    const review: Review = {
      id,
      createdAt: new Date(),
      updatedAt: new Date(),
      ...data
    };
    this.reviews.push(review);
    return review;
  }

  // Yorumu güncelle
  async updateReview(id: number, data: Partial<Review>): Promise<Review | undefined> {
    const index = this.reviews.findIndex(review => review.id === id);
    if (index === -1) return undefined;
    
    const updatedReview = {
      ...this.reviews[index],
      ...data,
      updatedAt: new Date()
    };
    
    this.reviews[index] = updatedReview;
    return updatedReview;
  }

  // Yorum moderasyonunu güncelle
  async updateReviewModeration(id: number, moderatorId: number, status: string, note?: string): Promise<Review | undefined> {
    const index = this.reviews.findIndex(review => review.id === id);
    if (index === -1) return undefined;
    
    const updatedReview = {
      ...this.reviews[index],
      status,
      moderatorId,
      moderatorNote: note,
      updatedAt: new Date()
    };
    
    this.reviews[index] = updatedReview;
    return updatedReview;
  }

  // Yorum faydalı sayısını güncelle
  async updateReviewHelpfulCount(id: number, increment: boolean): Promise<Review | undefined> {
    const index = this.reviews.findIndex(review => review.id === id);
    if (index === -1) return undefined;
    
    const currentCount = this.reviews[index].helpfulCount || 0;
    const updatedReview = {
      ...this.reviews[index],
      helpfulCount: increment ? currentCount + 1 : Math.max(0, currentCount - 1),
      updatedAt: new Date()
    };
    
    this.reviews[index] = updatedReview;
    return updatedReview;
  }

  // Yorumu sil
  async deleteReview(id: number): Promise<boolean> {
    const index = this.reviews.findIndex(review => review.id === id);
    if (index === -1) return false;
    
    this.reviews.splice(index, 1);
    return true;
  }
  
  // Yorum oylarını yönetme işlemleri
  async getReviewVote(id: number): Promise<ReviewVote | undefined> {
    return this.reviewVotes.find(vote => vote.id === id);
  }
  
  async getReviewVoteByUserAndReview(userId: number, reviewId: number): Promise<ReviewVote | undefined> {
    return this.reviewVotes.find(vote => vote.userId === userId && vote.reviewId === reviewId);
  }
  
  async getReviewVotesByReviewId(reviewId: number): Promise<ReviewVote[]> {
    return this.reviewVotes.filter(vote => vote.reviewId === reviewId);
  }
  
  async createReviewVote(data: InsertReviewVote): Promise<ReviewVote> {
    const id = this.nextReviewVoteId++;
    const vote: ReviewVote = {
      id,
      createdAt: new Date(),
      updatedAt: new Date(),
      ...data
    };
    this.reviewVotes.push(vote);
    
    // Yorumun oy sayılarını güncelle
    if (data.isHelpful) {
      this.updateReviewHelpfulCount(data.reviewId, true);
    }
    
    return vote;
  }
  
  async updateReviewVote(id: number, data: Partial<ReviewVote>): Promise<ReviewVote | undefined> {
    const index = this.reviewVotes.findIndex(vote => vote.id === id);
    if (index === -1) return undefined;
    
    const prevVote = this.reviewVotes[index];
    const updatedVote = {
      ...prevVote,
      ...data,
      updatedAt: new Date()
    };
    
    // Eğer oy değişmişse yorum sayılarını güncelle
    if (prevVote.isHelpful !== data.isHelpful && data.isHelpful !== undefined) {
      if (data.isHelpful) {
        this.updateReviewHelpfulCount(prevVote.reviewId, true);
      } else {
        this.updateReviewHelpfulCount(prevVote.reviewId, false);
      }
    }
    
    this.reviewVotes[index] = updatedVote;
    return updatedVote;
  }
  
  async deleteReviewVote(id: number): Promise<boolean> {
    const index = this.reviewVotes.findIndex(vote => vote.id === id);
    if (index === -1) return false;
    
    const vote = this.reviewVotes[index];
    if (vote.isHelpful) {
      this.updateReviewHelpfulCount(vote.reviewId, false);
    }
    
    this.reviewVotes.splice(index, 1);
    return true;
  }
  
