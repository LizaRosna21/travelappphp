  // Revenue Management - Analytics Dashboard
  async getTopRevenueRoutes(limit: number): Promise<any[]> {
    // Analizleri al ve toplam gelire göre sırala
    const revenueByRoute = new Map<number, number>();
    
    for (const analytic of this.revenueAnalytics) {
      if (!analytic.routeId) continue;
      
      const currentTotal = revenueByRoute.get(analytic.routeId) || 0;
      const revenue = parseFloat(analytic.totalRevenue);
      revenueByRoute.set(analytic.routeId, currentTotal + revenue);
    }
    
    // Sıralama yap
    const sortedRoutes = Array.from(revenueByRoute.entries())
      .sort((a, b) => b[1] - a[1])
      .slice(0, limit);
    
    // Rota bilgilerini getir
    return Promise.all(sortedRoutes.map(async ([routeId, totalRevenue]) => {
      const route = await this.getRoute(routeId);
      return {
        routeId,
        routeName: route ? `${route.departurePort} - ${route.arrivalPort}` : 'Unknown',
        totalRevenue
      };
    }));
  }
  
  async getTopOccupancyRoutes(limit: number): Promise<any[]> {
    // Rotalara göre doluluk oranı
    const occupancyByRoute = new Map<number, { totalOccupancy: number, count: number }>();
    
    for (const analytic of this.revenueAnalytics) {
      if (!analytic.routeId) continue;
      
      const current = occupancyByRoute.get(analytic.routeId) || { totalOccupancy: 0, count: 0 };
      const occupancyRate = parseFloat(analytic.occupancyRate);
      
      if (!isNaN(occupancyRate)) {
        occupancyByRoute.set(analytic.routeId, {
          totalOccupancy: current.totalOccupancy + occupancyRate,
          count: current.count + 1
        });
      }
    }
    
    // Ortalama doluluk oranına göre sıralama yap
    const sortedRoutes = Array.from(occupancyByRoute.entries())
      .map(([routeId, data]) => ({
        routeId,
        averageOccupancy: data.totalOccupancy / data.count
      }))
      .sort((a, b) => b.averageOccupancy - a.averageOccupancy)
      .slice(0, limit);
    
    // Rota bilgilerini getir
    return Promise.all(sortedRoutes.map(async (item) => {
      const route = await this.getRoute(item.routeId);
      return {
        routeId: item.routeId,
        routeName: route ? `${route.departurePort} - ${route.arrivalPort}` : 'Unknown',
        averageOccupancy: item.averageOccupancy
      };
    }));
  }
  
  async calculateDynamicPrice(routeId: number, scheduleId: number, departureDate: Date, basePrice: number): Promise<any> {
    // Get settings for this route
    const routeSettings = await this.getYeildManagementSettingByRouteId(routeId);
    const globalSettings = await this.getGlobalYeildManagementSettings();
    
    // Use route settings if available, otherwise use global settings
    const settings = routeSettings || globalSettings;
    
    if (!settings || !settings.isActive) {
      return { price: basePrice, pricingFactors: [] };
    }
    
    let adjustedPrice = basePrice;
    const pricingFactors = [];
    
    // 1. Check for special events
    const activeEvents = await this.getActiveSpecialEvents();
    let specialEventFactor = 0;
    
    for (const event of activeEvents) {
      if (event.routeId === routeId || event.routeId === null) {
        const factor = event.priceAdjustmentPercent ? parseFloat(event.priceAdjustmentPercent) / 100 : 0;
        specialEventFactor += factor;
        
        pricingFactors.push({
          type: 'specialEvent',
          name: event.name,
          impact: `${event.priceAdjustmentPercent}%`,
          description: event.description
        });
      }
    }
    
    adjustedPrice *= (1 + specialEventFactor);
    
    // 2. Check for demand forecast
    const forecast = (await this.getDemandForecastsByDateRange(routeId, departureDate, departureDate))[0];
    
    if (forecast) {
      // Higher demand means higher prices
      const forecastImpact = parseFloat(settings.demandSensitivity || "0.2");
      const forecastFactor = (parseFloat(forecast.predictedDemand) / 100) * forecastImpact;
      
      adjustedPrice *= (1 + forecastFactor);
      
      pricingFactors.push({
        type: 'demandForecast',
        impact: `${(forecastFactor * 100).toFixed(1)}%`,
        description: `Talep tahmini: ${forecast.predictedDemand}%`
      });
    }
    
    // 3. Check competitor prices
    const competitorPrices = await this.getCompetitorPricesByRouteId(routeId);
    const recentCompetitorPrices = competitorPrices
      .filter(p => new Date(p.capturedAt) >= new Date(Date.now() - 7 * 24 * 60 * 60 * 1000)); // Last 7 days
    
    if (recentCompetitorPrices.length > 0) {
      // Calculate average competitor price
      const avgCompetitorPrice = recentCompetitorPrices.reduce((sum, p) => sum + parseFloat(p.price), 0) / recentCompetitorPrices.length;
      
      // Adjust based on competitor price difference
      const competitiveFactor = parseFloat(settings.competitivePriceFactor || "0.3");
      const priceDiff = (avgCompetitorPrice - basePrice) / basePrice;
      const competitorAdjustment = priceDiff * competitiveFactor;
      
      // Limit the adjustment by settings
      const maxMarkup = parseFloat(settings.maxMarkupPercent || "50") / 100;
      const minDiscount = parseFloat(settings.minDiscountPercent || "10") / 100;
      
      const limitedAdjustment = Math.max(Math.min(competitorAdjustment, maxMarkup), -minDiscount);
      
      adjustedPrice *= (1 + limitedAdjustment);
      
      pricingFactors.push({
        type: 'competitorPrices',
        impact: `${(limitedAdjustment * 100).toFixed(1)}%`,
        description: `Rakip fiyat ortalaması: ${avgCompetitorPrice.toFixed(2)}`
      });
    }
    
    // 4. Apply advance booking discount
    const bookingDate = new Date();
    const daysUntilDeparture = Math.max(0, Math.floor((departureDate.getTime() - bookingDate.getTime()) / (1000 * 60 * 60 * 24)));
    
    if (settings.advanceBookingDiscount === true && daysUntilDeparture > 0) {
      const maxAdvanceDiscount = parseFloat(settings.maxAdvanceDiscountPercent || "15") / 100;
      const advanceDays = parseInt(settings.advanceDiscountDays || "30");
      
      const advanceBookingFactor = -Math.min(daysUntilDeparture / advanceDays, 1) * maxAdvanceDiscount;
      
      adjustedPrice *= (1 + advanceBookingFactor);
      
      pricingFactors.push({
        type: 'advanceBooking',
        impact: `${(advanceBookingFactor * 100).toFixed(1)}%`,
        description: `${daysUntilDeparture} gün önceden rezervasyon`
      });
    }
    
    // 5. Apply price floor
    const minPrice = basePrice * 0.7; // Ensure price doesn't go below 70% of base price
    adjustedPrice = Math.max(minPrice, adjustedPrice);
    
    // 6. Round price based on settings
    if (settings.roundPricesToNearest) {
      const roundFactor = parseInt(settings.roundPricesToNearest);
      adjustedPrice = Math.ceil(adjustedPrice / roundFactor) * roundFactor;
    }
    
    return {
      basePrice,
      price: adjustedPrice,
      pricingFactors
    };
  }
  
  async getApiConfigById(id: number): Promise<ApiConfig | undefined> {
    return this.apiConfigs.find(config => config.id === id);
  }

  async getAllApiConfigs(): Promise<ApiConfig[]> {
    return [...this.apiConfigs];
  }

  async createApiConfig(apiConfig: InsertApiConfig): Promise<ApiConfig> {
    const newConfig: ApiConfig = {
      id: this.nextApiConfigId++,
      createdAt: new Date(),
      updatedAt: new Date(),
      lastChecked: null,
      ...apiConfig,
    };
    this.apiConfigs.push(newConfig);
    return newConfig;
  }

  async updateApiConfig(id: number, apiConfigData: Partial<ApiConfig>): Promise<ApiConfig | undefined> {
    const index = this.apiConfigs.findIndex(config => config.id === id);
    if (index === -1) return undefined;
    
    this.apiConfigs[index] = {
      ...this.apiConfigs[index],
      ...apiConfigData,
      updatedAt: new Date()
    };
    
    return this.apiConfigs[index];
  }

  async deleteApiConfig(id: number): Promise<boolean> {
    const initialLength = this.apiConfigs.length;
    this.apiConfigs = this.apiConfigs.filter(config => config.id !== id);
    return this.apiConfigs.length < initialLength;
  }

