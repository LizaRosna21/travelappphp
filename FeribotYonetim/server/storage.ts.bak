  }

  async searchRoutes(departurePort: string, arrivalPort: string): Promise<Route[]> {
    console.log(`Searching for routes with departurePort: "${departurePort}", arrivalPort: "${arrivalPort}"`);
    
    // URL parametrelerinden gelen değerleri decode et
    try {
      // Try double decoding in case the URL was encoded twice
      if (departurePort) {
        departurePort = decodeURIComponent(departurePort);
        try { departurePort = decodeURIComponent(departurePort); } catch (e) { /* ignore if already decoded */ }
      }
      if (arrivalPort) {
        arrivalPort = decodeURIComponent(arrivalPort);
        try { arrivalPort = decodeURIComponent(arrivalPort); } catch (e) { /* ignore if already decoded */ }
      }
    } catch (e) {
      console.error("Error decoding URL parameters:", e);
    }
    
    console.log(`After decoding: departurePort: "${departurePort}", arrivalPort: "${arrivalPort}"`);
    
    // Statik veri dön
    const allRoutes = await this.getAllRoutes();
    
    // Hem kalkış hem varış portu verilmişse
    if (departurePort && arrivalPort) {
      // Önce tam eşleşme dene (case insensitive)
      const exactMatches = allRoutes.filter(route => 
        route.departurePort.toLowerCase() === departurePort.toLowerCase() && 
        route.arrivalPort.toLowerCase() === arrivalPort.toLowerCase() && 
        route.isActive
      );
      
      if (exactMatches.length > 0) {
        console.log(`Found ${exactMatches.length} routes with exact match`);
        return exactMatches;
      }
      
      // Kesin eşleşme yoksa, kelimelerden birini arayarak dene
      console.log("No exact matches found, trying partial matching with word search");
      
      // Whitespace veya tire benzeri karakterlere göre ayırıp ayrı ayrı ara
      const departureWords = departurePort.split(/[\s-]+/).filter(word => word.length > 2);
      const arrivalWords = arrivalPort.split(/[\s-]+/).filter(word => word.length > 2);
      
      console.log(`Searching with words: departure=${JSON.stringify(departureWords)}, arrival=${JSON.stringify(arrivalWords)}`);
      
      if (departureWords.length > 0 && arrivalWords.length > 0) {
        // Her iki tarafta da kelime varsa
        const wordMatches = allRoutes.filter(route => {
          const routeDepartureLower = route.departurePort.toLowerCase();
          const routeArrivalLower = route.arrivalPort.toLowerCase();
          
          // Herhangi bir kalkış kelimesi eşleşiyor mu?
          const departureMatch = departureWords.some(word => 
            routeDepartureLower.includes(word.toLowerCase())
          );
          
          // Herhangi bir varış kelimesi eşleşiyor mu?
          const arrivalMatch = arrivalWords.some(word => 
            routeArrivalLower.includes(word.toLowerCase())
          );
          
          return departureMatch && arrivalMatch && route.isActive;
        });
        
        if (wordMatches.length > 0) {
          console.log(`Found ${wordMatches.length} routes with word match`);
          return wordMatches;
        }
      }
      
      // Son olarak kısmi eşleşme ile dene
      console.log("No word matches found, trying generic partial matching");
      return allRoutes.filter(route => 
        route.departurePort.toLowerCase().includes(departurePort.toLowerCase()) && 
        route.arrivalPort.toLowerCase().includes(arrivalPort.toLowerCase()) && 
        route.isActive
      );
    }
    
    // Eğer sadece departurePort varsa
    if (departurePort && !arrivalPort) {
      return allRoutes.filter(route => 
        route.departurePort.toLowerCase() === departurePort.toLowerCase() && 
        route.isActive
      );
    }
    
    // Eğer sadece arrivalPort varsa
    if (!departurePort && arrivalPort) {
      return allRoutes.filter(route => 
        route.arrivalPort.toLowerCase() === arrivalPort.toLowerCase() && 
        route.isActive
      );
    }
    
    // Hiçbir parametre yoksa, aktif tüm rotaları döndür (en fazla 10 adet)
    return allRoutes.filter(route => route.isActive).slice(0, 10);
  }

