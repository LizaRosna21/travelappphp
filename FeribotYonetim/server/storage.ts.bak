  // MemStorage implementation for new methods

  // Kullanıcının rezervasyonlarını getir
  async getUserBookings(userId: number): Promise<Booking[]> {
    return this.getBookingsByUser(userId);
  }
  
  // Kullanıcının yorumlarını getir
  async getUserReviews(userId: number): Promise<Review[]> {
    return Array.from(this.reviews.values()).filter(review => review.userId === userId);
  }
  
  // Destek talepleri
  private supportRequests = new Map<number, SupportRequest>();
  private supportRequestsCounter = 0;
  
  async getSupportRequest(id: number): Promise<SupportRequest | undefined> {
    return this.supportRequests.get(id);
  }
  
  async getUserSupportRequests(userId: number): Promise<SupportRequest[]> {
    return Array.from(this.supportRequests.values()).filter(req => req.userId === userId);
  }
  
  async createSupportRequest(data: InsertSupportRequest): Promise<SupportRequest> {
    const id = ++this.supportRequestsCounter;
    const now = new Date();
    
    const supportRequest: SupportRequest = {
      id,
      createdAt: now,
      updatedAt: now,
      userId: data.userId,
      title: data.title || '',
      description: data.description || '',
      status: data.status || 'open',
      priority: data.priority || 'normal',
      category: data.category || 'general',
      resolution: null,
      closedAt: null,
      assignedToUserId: null,
      relatedBookingId: data.relatedBookingId || null,
      metadata: data.metadata || {},
    };
    
    this.supportRequests.set(id, supportRequest);
    return supportRequest;
  }
  
  async updateSupportRequest(id: number, data: Partial<SupportRequest>): Promise<SupportRequest | undefined> {
    const supportRequest = this.supportRequests.get(id);
    if (!supportRequest) {
      return undefined;
    }
    
    const updatedRequest = {
      ...supportRequest,
      ...data,
      updatedAt: new Date()
    };
    
    this.supportRequests.set(id, updatedRequest);
    return updatedRequest;
  }
  
  async updateSupportRequestStatus(id: number, status: string): Promise<SupportRequest | undefined> {
    return this.updateSupportRequest(id, { status });
  }
  
  async closeSupportRequest(id: number, resolution: string): Promise<SupportRequest | undefined> {
    return this.updateSupportRequest(id, { 
      status: 'closed',
      resolution,
      closedAt: new Date()
    });
  }
  
  async deleteSupportRequest(id: number): Promise<boolean> {
    return this.supportRequests.delete(id);
  }
  
  // Destek talep mesajları
  private supportMessages = new Map<number, SupportMessage>();
  private supportMessagesCounter = 0;
  
  async getSupportMessage(id: number): Promise<SupportMessage | undefined> {
    return this.supportMessages.get(id);
  }
  
  async getSupportMessagesBySupportRequestId(supportRequestId: number): Promise<SupportMessage[]> {
    return Array.from(this.supportMessages.values())
      .filter(msg => msg.supportRequestId === supportRequestId)
      .sort((a, b) => a.createdAt.getTime() - b.createdAt.getTime());
  }
  
  async createSupportMessage(data: InsertSupportMessage): Promise<SupportMessage> {
    const id = ++this.supportMessagesCounter;
    const now = new Date();
    
    const supportMessage: SupportMessage = {
      id,
      createdAt: now,
      updatedAt: now,
      supportRequestId: data.supportRequestId,
      senderId: data.senderId,
      message: data.message,
      isStaff: data.isStaff || false,
      isRead: false,
      attachments: data.attachments || null,
    };
    
    this.supportMessages.set(id, supportMessage);
    return supportMessage;
  }
  
  async updateSupportMessage(id: number, data: Partial<SupportMessage>): Promise<SupportMessage | undefined> {
    const supportMessage = this.supportMessages.get(id);
    if (!supportMessage) {
      return undefined;
    }
    
    const updatedMessage = {
      ...supportMessage,
      ...data,
      updatedAt: new Date()
    };
    
    this.supportMessages.set(id, updatedMessage);
    return updatedMessage;
  }
  
  async deleteSupportMessage(id: number): Promise<boolean> {
    return this.supportMessages.delete(id);
  }
  
  // Bildirimler
  private notifications = new Map<number, Notification>();
  private notificationsCounter = 0;
  
  async getNotification(id: number): Promise<Notification | undefined> {
    return this.notifications.get(id);
  }
  
  async getUserNotifications(userId: number): Promise<Notification[]> {
    return Array.from(this.notifications.values())
      .filter(notification => notification.userId === userId)
      .sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime()); // En yeniden en eskiye
  }
  
  async createNotification(data: InsertNotification): Promise<Notification> {
    const id = ++this.notificationsCounter;
    const now = new Date();
    
    const notification: Notification = {
      id,
      createdAt: now,
      updatedAt: now,
      userId: data.userId,
      title: data.title,
      message: data.message,
      notificationType: data.notificationType || 'general',
      isRead: data.isRead || false,
      relatedEntityType: data.relatedEntityType || null,
      relatedEntityId: data.relatedEntityId || null,
      metadata: data.metadata || {},
    };
    
    this.notifications.set(id, notification);
    return notification;
  }
  
  async markNotificationAsRead(id: number): Promise<Notification | undefined> {
    const notification = this.notifications.get(id);
    if (!notification) {
      return undefined;
    }
    
    const updatedNotification = {
      ...notification,
      isRead: true,
      updatedAt: new Date()
    };
    
    this.notifications.set(id, updatedNotification);
    return updatedNotification;
  }
  
  async markAllNotificationsAsRead(userId: number): Promise<void> {
    const userNotifications = Array.from(this.notifications.values())
      .filter(notification => notification.userId === userId);
    
    for (const notification of userNotifications) {
      this.notifications.set(notification.id, {
        ...notification,
        isRead: true,
        updatedAt: new Date()
      });
    }
  }
  
  async deleteNotification(id: number): Promise<boolean> {
    return this.notifications.delete(id);
  }
  
  // Sosyal paylaşımlar
  private socialShares = new Map<number, SocialShare>();
  private socialSharesCounter = 0;
  
  async getSocialShare(id: number): Promise<SocialShare | undefined> {
    return this.socialShares.get(id);
  }
  
  async getUserSocialShares(userId: number): Promise<SocialShare[]> {
    return Array.from(this.socialShares.values())
      .filter(share => share.userId === userId)
      .sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime());
  }
  
  async createSocialShare(data: InsertSocialShare): Promise<SocialShare> {
    const id = ++this.socialSharesCounter;
    const now = new Date();
    
    const socialShare: SocialShare = {
      id,
      createdAt: now,
      updatedAt: now,
      userId: data.userId,
      platform: data.platform,
      sharedUrl: data.sharedUrl,
      relatedEntityType: data.relatedEntityType || data.contentType,
      relatedEntityId: data.relatedEntityId || 0,
      shareStatus: data.shareStatus || 'completed',
      metadata: data.metadata || {},
    };
    
    this.socialShares.set(id, socialShare);
    return socialShare;
  }
  
  async updateSocialShare(id: number, data: Partial<SocialShare>): Promise<SocialShare | undefined> {
    const socialShare = this.socialShares.get(id);
    if (!socialShare) {
      return undefined;
    }
    
    const updatedShare = {
      ...socialShare,
      ...data,
      updatedAt: new Date()
    };
    
    this.socialShares.set(id, updatedShare);
    return updatedShare;
  }
  
  async deleteSocialShare(id: number): Promise<boolean> {
    return this.socialShares.delete(id);
  }
}

// Switch between MemStorage and DatabaseStorage as needed
// export const storage = new DatabaseStorage();
// Initialize storage and extend with content management methods
const memStorage = new MemStorage();
export const storage = extendMemStorageWithContentMethods(memStorage);
