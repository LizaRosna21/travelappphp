  async updateEmailSendStatus(id: number, status: string, statusTime?: Date): Promise<EmailSend | undefined> {
    const updates: Partial<EmailSend> = { status };
    
    if (status === 'opened' && statusTime) {
      updates.openedAt = statusTime;
    } else if (status === 'clicked' && statusTime) {
      updates.clickedAt = statusTime;
    } else if (status === 'bounced' && statusTime) {
      updates.bouncedAt = statusTime;
    } else if (status === 'unsubscribed' && statusTime) {
      updates.unsubscribedAt = statusTime;
    }
    
    const [updated] = await db
      .update(emailSends)
      .set(updates)
      .where(eq(emailSends.id, id))
      .returning();
    
    return updated;
  }

