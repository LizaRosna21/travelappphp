  async validateCoupon(code: string): Promise<{ valid: boolean; coupon?: Coupon; message?: string }> {
    try {
      const [coupon] = await db.select({
        id: coupons.id,
        code: coupons.code,
        createdAt: coupons.createdAt,
        updatedAt: coupons.updatedAt,
        campaignId: coupons.campaignId,
        metadata: coupons.metadata,
        discountType: coupons.discountType,
        discountValue: coupons.discountValue,
        startDate: coupons.startDate,
        endDate: coupons.endDate,
        usageLimit: coupons.usageLimit,
        usageCount: coupons.usageCount,
        isActive: coupons.isActive,
        minimumPurchaseAmount: coupons.minimumPurchaseAmount
      }).from(coupons).where(eq(coupons.code, code));
      
      if (!coupon) {
        // Eğer veritabanında bulunamazsa, demo kuponlara bak
        const demoCoupon = this.getDemoCoupons().find(c => c.code === code);
        if (!demoCoupon) {
          return { valid: false, message: "Coupon not found" };
        }
        coupon = demoCoupon;
      }
      
      if (!coupon.isActive) {
        return { valid: false, coupon, message: "Coupon is not active" };
      }
      
      const now = new Date();
      if (new Date(coupon.startDate) > now) {
        return { valid: false, coupon, message: "Coupon is not yet valid" };
      }
      
      if (new Date(coupon.endDate) < now) {
        return { valid: false, coupon, message: "Coupon has expired" };
      }
      
      if (coupon.usageLimit !== null && coupon.usageCount >= coupon.usageLimit) {
        return { valid: false, coupon, message: "Coupon usage limit reached" };
      }
      
      return { valid: true, coupon };
    } catch (error) {
      console.error("Error validating coupon:", error);
      // Eğer veritabanı hatası olursa, demo kuponları kontrol et
      const demoCoupon = this.getDemoCoupons().find(c => c.code === code);
      if (!demoCoupon) {
        return { valid: false, message: "Coupon not found" };
      }
      
      if (!demoCoupon.isActive) {
        return { valid: false, coupon: demoCoupon, message: "Coupon is not active" };
      }
      
      const now = new Date();
      if (new Date(demoCoupon.startDate) > now) {
        return { valid: false, coupon: demoCoupon, message: "Coupon is not yet valid" };
      }
      
      if (new Date(demoCoupon.endDate) < now) {
        return { valid: false, coupon: demoCoupon, message: "Coupon has expired" };
      }
      
      if (demoCoupon.usageLimit !== null && demoCoupon.usageCount >= demoCoupon.usageLimit) {
        return { valid: false, coupon: demoCoupon, message: "Coupon usage limit reached" };
      }
      
      return { valid: true, coupon: demoCoupon };
    }
  }

