    return this.priceRecommendations.filter(recommendation => recommendation.routeId === routeId);
  }
  
  async getPriceRecommendationsByScheduleId(scheduleId: number): Promise<PriceRecommendation[]> {
    return this.priceRecommendations.filter(recommendation => recommendation.scheduleId === scheduleId);
  }
  
  async createPriceRecommendation(data: InsertPriceRecommendation): Promise<PriceRecommendation> {
    const id = this.nextPriceRecommendationId++;
    const priceRecommendation: PriceRecommendation = {
      id,
      createdAt: new Date(),
      updatedAt: new Date(),
      ...data
    };
    this.priceRecommendations.push(priceRecommendation);
    return priceRecommendation;
  }
  
  async updatePriceRecommendation(id: number, data: Partial<PriceRecommendation>): Promise<PriceRecommendation | undefined> {
    const index = this.priceRecommendations.findIndex(recommendation => recommendation.id === id);
    if (index === -1) return undefined;
    
    const updatedRecommendation = {
      ...this.priceRecommendations[index],
      ...data,
      updatedAt: new Date()
    };
    
    this.priceRecommendations[index] = updatedRecommendation;
    return updatedRecommendation;
  }
  
  async applyPriceRecommendation(id: number, userId: number): Promise<PriceRecommendation | undefined> {
    const index = this.priceRecommendations.findIndex(recommendation => recommendation.id === id);
    if (index === -1) return undefined;
    
    const recommendation = this.priceRecommendations[index];
    
    // Find the route to update
    const route = await this.getRoute(recommendation.routeId);
    if (!route) return undefined;
    
    // Update the base price of the route
    await this.updateRoute(recommendation.routeId, {
      basePrice: recommendation.recommendedPrice,
    });
    
    // Update the recommendation status
    const updatedRecommendation = {
      ...recommendation,
      status: 'applied',
      appliedBy: userId,
      appliedAt: new Date(),
      updatedAt: new Date()
    };
    
    this.priceRecommendations[index] = updatedRecommendation;
    return updatedRecommendation;
  }
  
