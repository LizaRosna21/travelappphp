  // API yapılandırma işlemleri
  private apiConfigs: ApiConfiguration[] = [];
  private nextApiConfigId = 1;
  
  // B2B - Agency Management
  private agencies: Map<number, Agency> = new Map();
  private nextAgencyId = 1;
  
  // B2B - Agency Commission Tiers
  private agencyCommissionTiers: Map<number, AgencyCommissionTier> = new Map();
  private nextAgencyCommissionTierId = 1;
  
  // B2B - Agency Bookings
  private agencyBookings: Map<number, AgencyBooking> = new Map();
  private nextAgencyBookingId = 1;
  
  // B2B - Agency Payments
  private agencyPayments: Map<number, AgencyPayment> = new Map();
  private nextAgencyPaymentId = 1;
  
  // B2B - Agency Management Methods
  async getAllAgencies(): Promise<Agency[]> {
    return Array.from(this.agencies.values());
  }
  
  async getAgencyById(id: number): Promise<Agency | undefined> {
    return this.agencies.get(id);
  }
  
  async createAgency(data: Omit<Agency, "id" | "createdAt" | "updatedAt">): Promise<Agency> {
    const id = this.nextAgencyId++;
    const agency: Agency = {
      id,
      createdAt: new Date(),
      updatedAt: new Date(),
      ...data,
      currentBalance: "0",
    };
    this.agencies.set(id, agency);
    return agency;
  }
  
  async updateAgency(id: number, data: Partial<Agency>): Promise<Agency> {
    const agency = this.agencies.get(id);
    if (!agency) {
      throw new Error("Agency not found");
    }
    
    const updatedAgency: Agency = {
      ...agency,
      ...data,
      updatedAt: new Date(),
    };
    
    this.agencies.set(id, updatedAgency);
    return updatedAgency;
  }
  
  async deleteAgency(id: number): Promise<void> {
    if (!this.agencies.has(id)) {
      throw new Error("Agency not found");
    }
    
    this.agencies.delete(id);
    
    // Also delete associated commission tiers
    for (const [tierId, tier] of this.agencyCommissionTiers.entries()) {
      if (tier.agencyId === id) {
        this.agencyCommissionTiers.delete(tierId);
      }
    }
    
    // And bookings
    for (const [bookingId, booking] of this.agencyBookings.entries()) {
      if (booking.agencyId === id) {
        this.agencyBookings.delete(bookingId);
      }
    }
    
    // And payments
    for (const [paymentId, payment] of this.agencyPayments.entries()) {
      if (payment.agencyId === id) {
        this.agencyPayments.delete(paymentId);
      }
    }
  }
  
  async getSubAgencies(parentAgencyId: number): Promise<Agency[]> {
    return Array.from(this.agencies.values()).filter(
      (agency) => agency.parentAgencyId === parentAgencyId
    );
  }
  
  // B2B - Agency Commission Management Methods
  async getAgencyCommissionTiers(agencyId: number): Promise<AgencyCommissionTier[]> {
    return Array.from(this.agencyCommissionTiers.values()).filter(
      (tier) => tier.agencyId === agencyId
    );
  }
  
  async createAgencyCommissionTier(data: Omit<AgencyCommissionTier, "id" | "createdAt" | "updatedAt">): Promise<AgencyCommissionTier> {
    const id = this.nextAgencyCommissionTierId++;
    const tier: AgencyCommissionTier = {
      id,
      createdAt: new Date(),
      updatedAt: new Date(),
      ...data,
    };
    this.agencyCommissionTiers.set(id, tier);
    return tier;
  }
  
  async updateAgencyCommissionTier(id: number, data: Partial<AgencyCommissionTier>): Promise<AgencyCommissionTier> {
    const tier = this.agencyCommissionTiers.get(id);
    if (!tier) {
      throw new Error("Commission tier not found");
    }
    
    const updatedTier: AgencyCommissionTier = {
      ...tier,
      ...data,
      updatedAt: new Date(),
    };
    
    this.agencyCommissionTiers.set(id, updatedTier);
    return updatedTier;
  }
  
  async deleteAgencyCommissionTier(id: number): Promise<void> {
    if (!this.agencyCommissionTiers.has(id)) {
      throw new Error("Commission tier not found");
    }
    
    this.agencyCommissionTiers.delete(id);
  }
  
  // B2B - Agency Booking Management Methods
  async getAgencyBookings(agencyId: number): Promise<AgencyBooking[]> {
    return Array.from(this.agencyBookings.values()).filter(
      (booking) => booking.agencyId === agencyId
    );
  }
  
  async getAgencyBookingById(id: number): Promise<AgencyBooking | undefined> {
    return this.agencyBookings.get(id);
  }
  
  // B2B - Agency Payment Management Methods
  async getAgencyPayments(agencyId: number): Promise<AgencyPayment[]> {
    return Array.from(this.agencyPayments.values()).filter(
      (payment) => payment.agencyId === agencyId
    );
  }
  
  async getAgencyPaymentById(id: number): Promise<AgencyPayment | undefined> {
    return this.agencyPayments.get(id);
  }
  
  async createAgencyPayment(data: Omit<AgencyPayment, "id" | "createdAt" | "updatedAt">): Promise<AgencyPayment> {
    const id = this.nextAgencyPaymentId++;
    const payment: AgencyPayment = {
      id,
      createdAt: new Date(),
      updatedAt: new Date(),
      ...data,
    };
    this.agencyPayments.set(id, payment);
    
    // Update agency balance if needed
    const agency = this.agencies.get(data.agencyId);
    if (agency) {
      const currentBalance = parseFloat(agency.currentBalance);
      const paymentAmount = parseFloat(data.amount);
      
      if (data.status === "completed") {
        // If it's a payment to agency, subtract from balance
        // If it's a payment from agency, add to balance
        const newBalance = data.paymentMethod === "to_agency" 
          ? currentBalance - paymentAmount 
          : currentBalance + paymentAmount;
        
        agency.currentBalance = newBalance.toString();
        this.agencies.set(data.agencyId, agency);
      }
    }
    
    return payment;
  }
  
  async updateAgencyPayment(id: number, data: Partial<AgencyPayment>): Promise<AgencyPayment> {
    const payment = this.agencyPayments.get(id);
    if (!payment) {
      throw new Error("Payment not found");
    }
    
    // Check if status changed to completed and we need to update balance
    const wasCompleted = payment.status === "completed";
    const isNowCompleted = data.status === "completed";
    
    const updatedPayment: AgencyPayment = {
      ...payment,
      ...data,
      updatedAt: new Date(),
    };
    
    this.agencyPayments.set(id, updatedPayment);
    
    // Update agency balance if status changed
    if (!wasCompleted && isNowCompleted) {
      const agency = this.agencies.get(payment.agencyId);
      if (agency) {
        const currentBalance = parseFloat(agency.currentBalance);
        const paymentAmount = parseFloat(payment.amount);
        
        // If it's a payment to agency, subtract from balance
        // If it's a payment from agency, add to balance
        const newBalance = payment.paymentMethod === "to_agency" 
          ? currentBalance - paymentAmount 
          : currentBalance + paymentAmount;
        
        agency.currentBalance = newBalance.toString();
        this.agencies.set(payment.agencyId, agency);
      }
    }
    
    return updatedPayment;
  }
  
  // B2B - Agency User Management Methods
  async getUsersByAgencyId(agencyId: number): Promise<User[]> {
    return Array.from(this.users.values()).filter(
      (user) => user.parentAgencyId === agencyId
    );
  }
  
