  async updateEmailStats(id: number, stats: { opens?: number; clicks?: number; bounces?: number; unsubscribes?: number }): Promise<MarketingEmail | undefined> {
    const email = await this.getMarketingEmail(id);
    if (!email) return undefined;
    
    const updates: Partial<MarketingEmail> = {};
    
    if (stats.opens !== undefined) {
      updates.openCount = (email.openCount || 0) + stats.opens;
    }
    
    if (stats.clicks !== undefined) {
      updates.clickCount = (email.clickCount || 0) + stats.clicks;
    }
    
    if (stats.bounces !== undefined) {
      updates.bounceCount = (email.bounceCount || 0) + stats.bounces;
    }
    
    if (stats.unsubscribes !== undefined) {
      updates.unsubscribeCount = (email.unsubscribeCount || 0) + stats.unsubscribes;
    }
    
    const [updated] = await db
      .update(marketingEmails)
      .set(updates)
      .where(eq(marketingEmails.id, id))
      .returning();
    
    return updated;
  }

