  // Coupon Redemption operations
  async getCouponRedemption(id: number): Promise<CouponRedemption | undefined> {
    return this.couponRedemptions.get(id);
  }

  async getCouponRedemptionsByCouponId(couponId: number): Promise<CouponRedemption[]> {
    return Array.from(this.couponRedemptions.values()).filter(
      (redemption) => redemption.couponId === couponId
    );
  }

  async getCouponRedemptionsByBookingId(bookingId: number): Promise<CouponRedemption[]> {
    return Array.from(this.couponRedemptions.values()).filter(
      (redemption) => redemption.bookingId === bookingId
    );
  }

  async getCouponRedemptionsByUserId(userId: number): Promise<CouponRedemption[]> {
    return Array.from(this.couponRedemptions.values()).filter(
      (redemption) => redemption.userId === userId
    );
  }

  async createCouponRedemption(insertRedemption: InsertCouponRedemption): Promise<CouponRedemption> {
    const id = this.currentCouponRedemptionId++;
    const redemption: CouponRedemption = { 
      ...insertRedemption, 
      id,
      redeemedAt: new Date()
    };
    this.couponRedemptions.set(id, redemption);
    
    // Increment coupon usage
    if (insertRedemption.couponId) {
      await this.incrementCouponUsage(insertRedemption.couponId);
    }
    
    // Increment campaign usage if coupon is linked to a campaign
    const coupon = await this.getCoupon(insertRedemption.couponId);
    if (coupon && coupon.campaignId) {
      await this.incrementCampaignUsage(coupon.campaignId);
    }
    
    return redemption;
  }

  async deleteCouponRedemption(id: number): Promise<boolean> {
    return this.couponRedemptions.delete(id);
  }
  
