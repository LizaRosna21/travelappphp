  private nextRevenueAnalyticId = 1;
  
  private yeildManagementSettings: YeildManagementSetting[] = [];
  private nextYeildManagementSettingId = 1;
  
  // Review ve kullanıcı profili işlemleri için depolama
  private reviews: Review[] = [];
  private nextReviewId = 1;
  
  private reviewVotes: ReviewVote[] = [];
  private nextReviewVoteId = 1;
  
  private reviewReplies: ReviewReply[] = [];
  private nextReviewReplyId = 1;
  
  private userProfiles: UserProfile[] = [];
  private nextUserProfileId = 1;
  
