  async getSchedulesByRoute(routeId: number): Promise<Schedule[]> {
    console.log(`getSchedulesByRoute çağrıldı, routeId: ${routeId} - statik veri dönecek`);
    try {
      // Statik veri dön
      const allSchedules = await this.getAllSchedules();
      return allSchedules.filter(schedule => schedule.routeId === routeId);
    } catch (error) {
      console.error("Error in getSchedulesByRoute:", error);
      return [];
    }
  }

  async createSchedule(schedule: InsertSchedule): Promise<Schedule> {
