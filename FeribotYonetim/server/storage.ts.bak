  async getActiveCoupons(): Promise<Coupon[]> {
    try {
      const now = new Date();
      return await db
        .select({
          id: coupons.id,
          code: coupons.code,
          createdAt: coupons.createdAt,
          updatedAt: coupons.updatedAt,
          campaignId: coupons.campaignId,
          metadata: coupons.metadata,
          discountType: coupons.discountType,
          discountValue: coupons.discountValue,
          startDate: coupons.startDate,
          endDate: coupons.endDate,
          usageLimit: coupons.usageLimit,
          usageCount: coupons.usageCount,
          isActive: coupons.isActive,
          minimumPurchaseAmount: coupons.minimumPurchaseAmount
        })
        .from(coupons)
        .where(
          and(
            eq(coupons.isActive, true),
            sql`${coupons.startDate} <= ${now}`,
            sql`${coupons.endDate} >= ${now}`
          )
        );
    } catch (error) {
      console.error("Error in getActiveCoupons:", error);
      const now = new Date();
      // Filter active coupons from demo coupons
      return this.getDemoCoupons().filter(coupon => 
        coupon.isActive && new Date(coupon.startDate) <= now && new Date(coupon.endDate) >= now
      );
    }
  }
  
