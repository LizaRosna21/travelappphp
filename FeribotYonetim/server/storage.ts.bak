  async getAllApiConfigs(): Promise<ApiConfig[]> {
    try {
      return await db
        .select()
        .from(apiConfigs)
        .orderBy(apiConfigs.name);
    } catch (error) {
      console.error("Error in getAllApiConfigs:", error);
      return [];
    }
  }

  async createApiConfig(apiConfig: InsertApiConfig): Promise<ApiConfig> {
    try {
      const [newApiConfig] = await db
        .insert(apiConfigs)
        .values(apiConfig)
        .returning();
      return newApiConfig;
    } catch (error) {
      console.error("Error in createApiConfig:", error);
      throw error;
    }
  }

  async updateApiConfig(id: number, apiConfigData: Partial<ApiConfig>): Promise<ApiConfig | undefined> {
    try {
      const [updatedApiConfig] = await db
        .update(apiConfigs)
        .set(apiConfigData)
        .where(eq(apiConfigs.id, id))
        .returning();
      return updatedApiConfig;
    } catch (error) {
      console.error("Error in updateApiConfig:", error);
      return undefined;
    }
  }

  async deleteApiConfig(id: number): Promise<boolean> {
    try {
      await db
        .delete(apiConfigs)
        .where(eq(apiConfigs.id, id));
      return true;
    } catch (error) {
      console.error("Error in deleteApiConfig:", error);
      return false;
    }
  }
  
